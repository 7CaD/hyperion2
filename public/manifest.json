{
  "manifest_version": 3,
  "name": "Hyperion2",
  "description": "A fast fuzzy Chrome tab manager.",
  "version": "0.1.0",
  "action": {
    "default_title": "Open Hyperion2"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Open Hyperion2"
    }
  },
  "permissions": ["storage", "system.display", "tabGroups", "tabs"]
}
